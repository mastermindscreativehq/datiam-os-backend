PORT=4000
NODE_ENV=development

# Supabase / PostgreSQL connection string
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# Direct (non-pooled) connection used only for running migrations — see
# drizzle.config.ts. Same format as DATABASE_URL above.
MIGRATION_DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require

# JWT — generate your own random 32+ character secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-minimum-32-character-secret-key

# Redis (optional — required for BullMQ queue processing)
REDIS_URL=redis://localhost:6379

# Supabase (for storage / client SDK usage)
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key — Supabase Dashboard → Settings → API → service_role.
# Full admin access, bypasses RLS. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# n8n Automation Layer
# Base URL of your n8n instance (local: http://localhost:5678, production: https://your-n8n.railway.app)
N8N_WEBHOOK_BASE_URL=http://localhost:5678
# Shared secret between DATIAM backend and n8n (set same value in n8n workflow header check)
N8N_WEBHOOK_SECRET=your-strong-webhook-secret-here

# AI integrations (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Error monitoring (optional — set in Railway Variables to enable Sentry)
# Get DSN from: Sentry project → Settings → Client Keys (DSN)
SENTRY_DSN=https://your-sentry-key@oXXXXXXX.ingest.us.sentry.io/XXXXXXX

# Audio Pipeline (Phase 6)
# Supabase Storage bucket name for audio files (create this bucket in Supabase Dashboard)
SUPABASE_STORAGE_BUCKET=audio-uploads

# ── Growth OS ─────────────────────────────────────────────────────────────────

# Admin credentials (required for seed and login)
ADMIN_EMAIL=admin@datiam.com
ADMIN_PASSWORD=your-strong-password-here

# Social platform API credentials (optional — required for live publishing/analytics)
# Instagram / Facebook Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Spotify for Developers (analytics read)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# X (Twitter) API v2
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Growth OS internal settings
# Maximum number of scheduled posts to process per BullMQ tick
GROWTH_PUBLISH_CONCURRENCY=3
# Trend scan interval in milliseconds (default 3600000 = 1 hour)
GROWTH_TREND_SCAN_INTERVAL_MS=3600000
# Analytics sync interval in milliseconds (default 14400000 = 4 hours)
GROWTH_ANALYTICS_SYNC_INTERVAL_MS=14400000

# ── Release Intel Mission Dispatcher ───────────────────────────────────────────
# Missions dispatch through the existing BullMQ + Automation Registry + n8n
# stack (N8N_WEBHOOK_BASE_URL / N8N_WEBHOOK_SECRET above, REDIS_URL above).
# The two vars below are only consumed by the n8n-side mission workflow
# templates (n8n/workflows/{playlist-pitch,sync-pitch,fan-growth,
# content-calendar,press-outreach,analytics-refresh}.template.json) — set
# them in n8n/docker-compose.n8n.yml, not here. Playlist/fan/content/analytics
# missions reuse the Spotify/YouTube/Instagram/TikTok credentials already
# defined above; these two are new and optional (missions run and report
# "partial" with the specific gap until connected):
# SYNC_LICENSING_API_KEY=            (sync/film/TV/game licensing data source)
# MEDIA_CONTACT_DISCOVERY_API_KEY=   (blog/radio/DJ/curator contact discovery)
